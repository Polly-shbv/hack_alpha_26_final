#!/bin/sh
set -eu
cd "$(dirname "$0")/.."
. scripts/env.sh
# Use installed browser when available; otherwise `pnpm exec playwright install chromium`.
TASK_BROWSER="/Users/polinasibaeva/Library/Caches/ms-playwright/chromium-1234/chrome-mac-arm64/Google Chrome for Testing.app/Contents/MacOS/Google Chrome for Testing"
if [ -z "${PLAYWRIGHT_CHROMIUM_EXECUTABLE:-}" ] && [ -x "$TASK_BROWSER" ]; then export PLAYWRIGHT_CHROMIUM_EXECUTABLE="$TASK_BROWSER"; fi
node node_modules/@playwright/test/cli.js test "$@"
